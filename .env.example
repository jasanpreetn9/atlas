# Atlas — upstream Sonarr / Radarr connection (required).
# Copy to `.env` (git-ignored) and fill in. At least one app must be configured;
# screens that need the other app will show as empty until it is set.
#
# The API key is in each app under Settings → General → Security ("API Key").

# Sonarr (TV). Default port 8989.
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# Radarr (Movies). Default port 7878.
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
